# Copy to .env and adjust. The .env file is git-ignored.

# HTTP/WebSocket server port
PORT=3000

# Admin credentials — only the admin can create rooms.
# Change these before any real use.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Minutes a room can stay open without anyone broadcasting before it is closed.
ROOM_TTL_MINUTES=10

# Max participants per room (broadcaster + viewers).
MAX_PARTICIPANTS=3
