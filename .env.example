# Copy to .env and adjust. The .env file is git-ignored.

# HTTP/WebSocket server port
PORT=3000

# Admin credentials — only the admin can create rooms.
# Change these before any real use.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Minutes a room can stay open without anyone broadcasting before it is closed.
ROOM_TTL_MINUTES=10

# Max participants per room (broadcaster + viewers).
MAX_PARTICIPANTS=3

# Comma-separated hostnames allowed as the WebSocket Origin. Leave empty for
# local dev (same-origin only). In production behind a tunnel/proxy, set this to
# the public host(s) so browser WebSockets are accepted, e.g.:
# ALLOWED_ORIGINS=concorde.example.com
ALLOWED_ORIGINS=

# Minutes between heartbeat log lines with the metrics snapshot (uptime, active
# connections/rooms, cumulative counters). Set to 0 to disable the heartbeat;
# the /admin/metrics endpoint (admin auth) still works either way.
STATS_INTERVAL_MINUTES=15

# Seconds between WebSocket keepalive pings. Keeps the signaling socket from being
# closed for idleness by a proxy/tunnel (e.g. Cloudflare ~100s) once the P2P
# media is flowing and the socket goes quiet. Set to 0 to disable.
WS_PING_SECONDS=30

# Wrong passwords allowed in a row per visitor (admin and room passwords counted
# separately) before that visitor is locked out for LOGIN_LOCKOUT_MINUTES — even
# the right password is refused meanwhile. Set LOGIN_MAX_FAILURES=0 to disable.
LOGIN_MAX_FAILURES=3
LOGIN_LOCKOUT_MINUTES=15
