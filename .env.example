# Copy to .env and adjust. The .env file is git-ignored.

# HTTP/WebSocket server port
PORT=3000

# The admin: the only login that gets the admin panel. The password is stored
# only as a bcrypt hash — generate the line below with `concorde hash` and paste
# it here. There is no ADMIN_PASSWORD any more: if one is still set, the server
# refuses to start rather than quietly accept a password in the clear.
# With no hash set at all, the server invents a strong password for that one run
# and prints it in the log.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Where the broadcaster accounts live (JSON, created on first write; holds
# password hashes, never passwords). Friends listed here can open a room and
# broadcast, but have no access to the admin panel. Manage them in the panel or
# with `concorde account add|passwd|rm <name>`. In production keep this outside
# the repo folder, e.g. C:\concorde\accounts.json.
ACCOUNTS_FILE=accounts.json

# Minutes a room can stay open without anyone broadcasting before it is closed.
ROOM_TTL_MINUTES=10

# Max participants per room (broadcaster + viewers).
MAX_PARTICIPANTS=3

# Comma-separated hostnames allowed as the WebSocket Origin. Leave empty for
# local dev (same-origin only). In production behind a tunnel/proxy, set this to
# the public host(s) so browser WebSockets are accepted, e.g.:
# ALLOWED_ORIGINS=concorde.example.com
ALLOWED_ORIGINS=

# Minutes between heartbeat log lines with the metrics snapshot (uptime, active
# connections/rooms, cumulative counters). Set to 0 to disable the heartbeat;
# the /admin/metrics endpoint (admin auth) still works either way.
STATS_INTERVAL_MINUTES=15

# Seconds between WebSocket keepalive pings. Keeps the signaling socket from being
# closed for idleness by a proxy/tunnel (e.g. Cloudflare ~100s) once the P2P
# media is flowing and the socket goes quiet. Set to 0 to disable.
WS_PING_SECONDS=30

# Seconds a participant's seat is held after their socket drops, so the page can
# reconnect and land back in the same room with the same role, without the other
# participants seeing anything. The broadcaster's window is the room TTL instead:
# the room exists for their stream, so it stays idle until they come back or the
# reaper closes it. Set to 0 to disable resuming (a dropped socket leaves at once).
RESUME_GRACE_SECONDS=30

# Wrong passwords allowed in a row per visitor (admin and room passwords counted
# separately) before that visitor is locked out for LOGIN_LOCKOUT_MINUTES — even
# the right password is refused meanwhile. Set LOGIN_MAX_FAILURES=0 to disable.
LOGIN_MAX_FAILURES=3
LOGIN_LOCKOUT_MINUTES=15
